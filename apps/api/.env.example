PORT=4000
APP_ADMIN_EMAILS=
NODE_ENV=development
API_REQUEST_TIMEOUT_MS=120000
API_HEADERS_TIMEOUT_MS=60000
API_KEEP_ALIVE_TIMEOUT_MS=5000
API_SHUTDOWN_TIMEOUT_MS=10000
CHAT_JOB_EXECUTION_TIMEOUT_MS=660000
API_TRUST_PROXY_HOPS=0
APP_TEST_MODE=false
# Comma-separated browser origins allowed to call the API in production.
# Leave blank in local development to allow same-machine testing.
CORS_ALLOWED_ORIGINS=
# Required in hosted environments. Protects GET /api/observability/metrics.
OBSERVABILITY_DASHBOARD_TOKEN=
# Optional retained logs, metrics, and traces. Copy these values from the
# OpenTelemetry connection in Grafana Cloud. Leave both blank locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=for-the-baddiez-api-local
OPENAI_API_KEY=
OPENAI_RUN_INTEGRATION_TESTS=false
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT_MS=120000
# General hard ceiling for model output. Lower this to shorten all responses.
OPENAI_MAX_OUTPUT_TOKENS=4096
# Audio requests use the lower of this value and OPENAI_MAX_OUTPUT_TOKENS.
OPENAI_AUDIO_MAX_OUTPUT_TOKENS=1230
# Roughly 80 seconds with the current 15-characters-per-second estimate.
CHAT_AUDIO_MAX_RESPONSE_CHARACTERS=1200
# Optional global OpenAI generation controls. Leave blank to use model defaults.
OPENAI_TEMPERATURE=
OPENAI_TOP_P=
OPENAI_PRESENCE_PENALTY=
OPENAI_FREQUENCY_PENALTY=
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_SUMMARY=
OPENAI_TEXT_VERBOSITY=
# Direct persona path defaults. top_p is optional; if set, it overrides persona temperature.
OPENAI_PERSONA_TEMPERATURE=
OPENAI_PERSONA_TOP_P=
OPENAI_PERSONA_PRESENCE_PENALTY=
OPENAI_PERSONA_FREQUENCY_PENALTY=
OPENAI_PERSONA_REASONING_EFFORT=high
OPENAI_PERSONA_REASONING_SUMMARY=
OPENAI_PERSONA_TEXT_VERBOSITY=high
OPENAI_MAX_RETRIES=3
OPENAI_IMAGE_REQUEST_TIMEOUT_MS=300000
OPENAI_BACKGROUND_POLL_TIMEOUT_MS=600000
OPENAI_BACKGROUND_POLL_INTERVAL_MS=1500
OPENAI_MAX_TOOL_ITERATIONS=4
OPENAI_MAX_CONTEXT_MESSAGES=24
OPENAI_MAX_CONTEXT_CHARACTERS=50000
OPENAI_MAX_CONTEXT_TOKENS=12000
CONVERSATION_MEMORY_SUMMARY_ENABLED=true
CONVERSATION_MEMORY_SUMMARY_AFTER_MESSAGES=24
CONVERSATION_MEMORY_SUMMARY_MAX_CHARACTERS=2500
CONVERSATION_MEMORY_SUMMARY_MAX_TOKENS=800
OPENAI_STYLE_REFERENCE_SYNTHETIC_LIMIT=20
OPENAI_STYLE_REFERENCE_GOLDEN_LIMIT=5
OPENAI_STYLE_REFERENCE_MAX_TOKENS=9000
OPENAI_TOOL_ROUTER_ENABLED=true
OPENAI_TOOL_ROUTER_MODEL=gpt-5.6-luna
OPENAI_ENABLE_WEB_SEARCH=true
OPENAI_ENABLE_FILE_SEARCH=true
OPENAI_ENABLE_CODE_INTERPRETER=true
OPENAI_ENABLE_IMAGE_GENERATION=true
OPENAI_DIRECT_IMAGE_API_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_MODERATION=low
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=auto
OPENAI_TTS_SCRIPT_ENABLED=false
# Current gpt-5.6-luna standard rates used only for estimated-cost metadata.
# Update these when OPENAI_MODEL or provider pricing changes.
OPENAI_INPUT_COST_PER_MILLION=1
OPENAI_OUTPUT_COST_PER_MILLION=6
OPENAI_DAILY_SPEND_LIMIT_USD=5
OPENAI_DAILY_TOKEN_LIMIT=1000000
# Provider-neutral estimates used by the monthly total-usage meter.
# Adjust these when the configured TTS, image-input, or style-transfer provider changes.
CUSTOMER_USAGE_AUDIO_COST_PER_MINUTE_USD=0.021
CUSTOMER_USAGE_IMAGE_INPUT_COST_USD=0.01
CUSTOMER_USAGE_STYLE_TRANSFER_COST_PER_CALL_USD=0.01
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_MS=60000
# Layered chat protection. Device/IP limits are deliberately higher than the
# per-account limit so shared networks are not blocked by one ordinary user.
CHAT_DEVICE_RATE_LIMIT_REQUESTS=45
CHAT_IP_RATE_LIMIT_REQUESTS=120
DATABASE_URL=postgres://persona:persona_dev_password@localhost:5434/persona_wrapper_db
STORAGE_DRIVER=local
# One local root for uploaded files, generated images/files, and generated audio.
# Leave blank to use UPLOAD_DIR plus the legacy generated-media/generated-audio subfolders.
STORAGE_LOCAL_ROOT=/Volumes/ReggieSSD/mac/coding-projects/python/persona_wrapper/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production only. Set STORAGE_DRIVER=s3 with NODE_ENV=production to store object bytes in S3.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
# Optional prefix for separating environments in one bucket, for example prod/persona-wrapper.
STORAGE_S3_PREFIX=
# Optional endpoint/path-style settings for S3-compatible storage. Leave blank/false for AWS S3.
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
UPLOAD_DIR=apps/api/uploads
# Legacy upload path used when STORAGE_LOCAL_ROOT is blank.
# Generated provider media is persisted outside conversation JSON. Leave blank to use UPLOAD_DIR/generated-media.
GENERATED_MEDIA_DIR=
# Legacy generated media path used when STORAGE_LOCAL_ROOT is blank.
# 0 keeps generated conversation media until it is manually deleted.
GENERATED_MEDIA_TTL_HOURS=0
# 0 keeps OpenAI artifact files until they are manually deleted.
OPENAI_ARTIFACT_TTL_HOURS=0
# Generated TTS audio can be stored separately from temporary uploads. Leave blank to use UPLOAD_DIR/generated-audio.
GENERATED_AUDIO_DIR=
# Legacy generated audio path used when STORAGE_LOCAL_ROOT is blank.
# 236 keeps generated response audio for a little under 10 days.
GENERATED_AUDIO_TTL_HOURS=236
# Kept below the OpenAI Images API 50 MB per-input-image limit.
UPLOAD_MAX_BYTES=49999999
# 24 keeps uploaded assets for one day.
UPLOAD_TTL_HOURS=24
# Runs upload/generated-media/generated-audio expiration cleanup every 15 minutes. Set 0 to disable.
STORAGE_CLEANUP_INTERVAL_MS=900000
STORAGE_CLEANUP_CRON=*/15 * * * *
ANTHROPIC_API_KEY=
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_NUM_CTX=8192
LOCAL_LLM_NUM_PREDICT=1024
TTS_PROVIDER=fish_audio
OPENAI_TTS_VOICE=alloy
#Fish audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_API_URL=https://api.fish.audio/v1/tts
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_REFERENCE_ID_LARAE=
FISH_AUDIO_REFERENCE_ID_BAMBAM=
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_FORMAT=mp3
FISH_AUDIO_SAMPLE_RATE=44100
FISH_AUDIO_MP3_BITRATE=128
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_SPEED=1
FISH_AUDIO_VOLUME=0
FISH_AUDIO_TEMPERATURE=0.7
FISH_AUDIO_TOP_P=0.7
FISH_AUDIO_MAX_RETRIES=2
FISH_AUDIO_RETRY_BASE_MS=400
FISH_AUDIO_RETRY_MAX_MS=10000
FISH_AUDIO_MAX_RESPONSE_BYTES=26214400
# ElevenLabs remains available as an alternate TTS provider.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_LARAE=
ELEVENLABS_VOICE_ID_BAMBAM=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SPEED=1.06
ELEVENLABS_STABILITY=0.30
ELEVENLABS_SIMILARITY_BOOST=0.60
ELEVENLABS_STYLE=0.10
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_MAX_RETRIES=2
ELEVENLABS_RETRY_BASE_MS=400
STYLE_TRANSFER_PROVIDER=stub
STYLE_TRANSFER_ENDPOINT=
STYLE_TRANSFER_MODEL_ID=

# Optional OAuth credentials for social login. Leave blank to disable.
AUTH_REQUIRED=false
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_MIN_LENGTH=10
TERMS_POLICY_VERSION=2026-07-29
PRIVACY_POLICY_VERSION=2026-07-31
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GMAIL_SMTP_USER=example@gmail.com
GMAIL_SMTP_APP_PASSWORD=
AUTH_ACCOUNT_DELETION_GRACE_DAYS=30
AUTH_REQUIRE_OWNED_MEDIA_ACCESS=false
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_SIGNUP_DEVICE_LIMIT=3
AUTH_SIGNUP_IP_LIMIT=100
# Thirty-day anti-rotation window for new free accounts.
AUTH_SIGNUP_WINDOW_MS=2592000000
# Leave false while validating usage telemetry. Set true only after plan
# assignments and monthly counters have been verified in the target environment.
CUSTOMER_USAGE_ENFORCEMENT_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
DATA_TRANSFER_RATE_LIMIT_REQUESTS=10
DATA_TRANSFER_RATE_LIMIT_WINDOW_MS=900000
API_JSON_MAX_BYTES=1048576
DATA_TRANSFER_MAX_BYTES=26214400
# Maximum compressed and expanded ZIP archive size. S3 direct uploads use a single PUT and therefore cap at 5 GiB.
DATA_TRANSFER_ARCHIVE_MAX_BYTES=5368709120
# Conversation/account JSON remains deliberately memory-bounded; large media is streamed directly between ZIP and storage.
DATA_TRANSFER_JSON_MAX_BYTES=134217728
# Direct S3 source uploads can take time on mobile networks; the presigned URL remains valid for five hours.
DATA_TRANSFER_PRESIGNED_UPLOAD_TTL_SECONDS=18000
# Completed archives and job records expire after this many hours.
DATA_TRANSFER_JOB_TTL_HOURS=24
WEB_APP_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
