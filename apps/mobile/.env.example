# Local simulator default. On a physical phone, use your computer's LAN IP,
# for example http://192.168.1.20:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_APP_URL=http://localhost:5173
# Android hosted builds use this verified App Link host. Keep localhost during
# local development; the app falls back to the personawrapper:// scheme there.
EXPO_PUBLIC_ANDROID_APP_LINK_HOST=for-the-baddiez-web-dev.onrender.com

# AdMob native app IDs are required only for production native builds. Local,
# development, and preview builds always use Google's official test IDs.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-1555286261518615~2589155767
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-1555286261518615~3228480284
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-1555286261518615/2899664457
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-1555286261518615/4021174432
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-1555286261518615/6700821437
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-1555286261518615/6468992341

# Preview/prod EAS builds should set this to the deployed API URL.
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_WEB_APP_URL=https://www.forthebaddiez.com
# EXPO_PUBLIC_ANDROID_APP_LINK_HOST=www.forthebaddiez.com
