{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://for-the-baddiez-api-dev.onrender.com",
        "EXPO_PUBLIC_WEB_APP_URL": "https://for-the-baddiez-web-dev.onrender.com",
        "EXPO_PUBLIC_ANDROID_APP_LINK_HOST": "for-the-baddiez-web-dev.onrender.com"
      }
    },
    "play-internal": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "play-internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://for-the-baddiez-api.onrender.com",
        "EXPO_PUBLIC_WEB_APP_URL": "https://for-the-baddiez-web.onrender.com",
        "EXPO_PUBLIC_ANDROID_APP_LINK_HOST": "for-the-baddiez-web.onrender.com",
        "EXPO_PUBLIC_REQUIRE_REVENUECAT_CONFIGURATION": "true"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://for-the-baddiez-api.onrender.com",
        "EXPO_PUBLIC_WEB_APP_URL": "https://for-the-baddiez-web.onrender.com",
        "EXPO_PUBLIC_REQUIRE_REVENUECAT_CONFIGURATION": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://for-the-baddiez-api.onrender.com",
        "EXPO_PUBLIC_WEB_APP_URL": "https://for-the-baddiez-web.onrender.com",
        "EXPO_PUBLIC_ANDROID_APP_LINK_HOST": "for-the-baddiez-web.onrender.com",
        "EXPO_PUBLIC_REQUIRE_REVENUECAT_CONFIGURATION": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
